      "header": [
        {
          "element": "api-id",
          "depth": 0,
          "is_section": false,
          "한글명": "TR명",
          "type": "String",
          "required": "Y",
          "length": "10",
          "description": "7자리 TR코드, ex) ka00001"
        },
        {
          "element": "cont-yn",
          "depth": 0,
          "is_section": false,
          "한글명": "연속조회여부",
