          "required": "N",
          "length": "50",
          "description": "다음 데이터가 있을시 다음 키값 전달"
        }
      ],
      "body": [
        {
          "element": "stk_nm",
          "depth": 0,
          "is_section": false,
          "한글명": "종목명",
          "type": "String",
          "required": "N",
          "length": "50",
          "description": ""
        },
        {
          "element": "ord_no",
          "depth": 0,
          "is_section": false,
          "한글명": "주문번호",
          "type": "String",
          "required": "N",
          "length": "9",
          "description": "취소 혹은 정정 주문 시 사용"
        },
        {
          "element": "fc_entra",
          "depth": 0,
          "is_section": false,
          "한글명": "외화예수금",
          "type": "String",
          "required": "N",
          "length": "12",
          "description": ""
        },
        {
          "element": "tdy_rebuy_useda",
          "depth": 0,
          "is_section": false,
          "한글명": "금일재매수사용금액",
          "type": "String",
          "required": "N",
          "length": "12",
          "description": ""
        },
        {
          "element": "pred_rebuy_useda",
          "depth": 0,
          "is_section": false,
          "한글명": "전일재매수사용금액",
          "type": "String",
          "required": "N",
          "length": "12",
          "description": ""
        },
        {
          "element": "trst_prof_ch",
          "depth": 0,
          "is_section": false,
          "한글명": "사용증거금",
          "type": "String",
          "required": "N",
          "length": "12",
          "description": ""
        }
      ]
    },
    "request_example": "{\n    \"stex_tp\": \"ND\",\n    \"stk_cd\": \"NVDA\",\n    \"ord_qty\": \"10\",\n    \"ord_uv\": \"213.04\",\n    \"trde_tp\": \"00\"\n}",
