                      "iem_cd": {
                        "type": "string",
                        "description": "티커종목코드 / 길이 12 / 예시> 미국주식 APPLE인 경우, AAPL"
                      },
                      "orr_qty": {
                        "type": "integer",
                        "format": "int64",
                        "description": "주문수량 / 길이 18 / 주문수량"
                      },
                      "fc_orr_uit_pr": {
                        "type": "number",
                        "format": "double",
                        "description": "외화주문단가 / 길이 15.6 / 주문단가 - 소수점 2자리까지(향후변경예정) \"현물호가유형코드\" 00,11,12,61,62,63 시 필수"
                      },
                      "ahi_nmn_pr_tp_cd": {
                        "type": "string",
